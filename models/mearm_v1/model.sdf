      <cmd_max>0.8</cmd_max>
    </plugin>
    <joint name="wrist_joint" type="revolute">
      <parent>forearm</parent>
      <child>hand</child>
      <pose relative_to="hand">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="hand">0 -1 0</xyz>
        <limit>
          <lower>-0.785398163397</lower>
          <upper>0.785398163397</upper>
          <effort>0.15</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
        <mimic joint="elbow_joint" axis="axis">
          <multiplier>-1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
      </axis>
    </joint>
    <joint name="left_finger_joint" type="revolute">
      <parent>hand</parent>
      <child>left_finger</child>
      <pose relative_to="left_finger">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="left_finger">0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.5</upper>
          <effort>0.15</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_finger_joint</joint_name>
      <initial_position>0</initial_position>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.8</cmd_max>
    </plugin>
    <joint name="right_finger_joint" type="revolute">
      <parent>hand</parent>
      <child>right_finger</child>
      <pose relative_to="right_finger">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="right_finger">0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0</upper>
          <effort>0.15</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
        <mimic joint="left_finger_joint" axis="axis">
          <multiplier>-1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
      </axis>
    </joint>
    <joint name="upper_parallel_joint" type="revolute">
      <parent>yaw</parent>
      <child>upper_parallel</child>
      <pose relative_to="upper_parallel">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="upper_parallel">0 -1 0</xyz>
        <limit>
          <lower>-0.785398163397</lower>
          <upper>0.785398163397</upper>
          <effort>0.15</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
        <mimic joint="shoulder_joint" axis="axis">
          <multiplier>1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
      </axis>
    </joint>
    <joint name="forearm_parallel_joint" type="revolute">
      <parent>elbow_comp</parent>
      <child>forearm_parallel</child>
      <pose relative_to="forearm_parallel">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="forearm_parallel">0 -1 0</xyz>
        <limit>
          <lower>-0.785398163397</lower>
          <upper>0.785398163397</upper>
          <effort>0.15</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
        <mimic joint="elbow_joint" axis="axis">
          <multiplier>1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
      </axis>
    </joint>
    <joint name="base_servo_fixed" type="fixed">
      <parent>base</parent>
      <child>base_servo</child>
    </joint>
    <joint name="left_servo_fixed" type="fixed">
      <parent>yaw</parent>
      <child>left_servo</child>
    </joint>
    <joint name="right_servo_fixed" type="fixed">
      <parent>yaw</parent>
      <child>right_servo</child>
    </joint>
    <joint name="gripper_servo_fixed" type="fixed">
      <parent>hand</parent>
      <child>gripper_servo</child>
    </joint>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher" />
  </model>
</sdf>